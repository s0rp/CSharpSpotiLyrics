<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>CSharpSpotiLyrics</PackageId>
		<Authors>s0rp</Authors>
		<Product>CSharpSpotiLyrics</Product>
		<Title>CSharpSpotiLyrics</Title>
		<Description>Spotify Lyrics Fetcher in C#</Description>
		<PackageProjectUrl>https://github.com/s0rp/CSharpSpotiLyrics</PackageProjectUrl>
		<RepositoryUrl>https://github.com/s0rp/CSharpSpotiLyrics</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>spotify lyrics spotify-lyrics</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

		<TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion>2.0.3.0</AssemblyVersion>
		<FileVersion>2.0.3.0</FileVersion>
		<Version>2.0.3-canary.1</Version>

		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<NoWarn>$(NoWarn);nullable</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<NoWarn>$(NoWarn);nullable</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE" Pack="True" PackagePath="\" />
		<None Include="..\README.md" Pack="True" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Net.Http.Json" Version="9.0.4" />
		<PackageReference Include="System.Text.Json" Version="9.0.4" />
	</ItemGroup>
</Project>
